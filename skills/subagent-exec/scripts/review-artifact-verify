#!/usr/bin/env node

import { createHash } from 'node:crypto';
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';

import { validateReviewResult } from './review-result-lib.mjs';

function option(name) {
  const index = process.argv.indexOf(name);
  return index === -1 ? null : process.argv[index + 1];
}

function sha256(content) {
  return createHash('sha256').update(content).digest('hex');
}

const artifactPath = option('--artifact');
const taskAnchor = option('--task');
const reviewerThreadId = option('--reviewer-thread');
const model = option('--model');
const attempt = Number(option('--attempt'));
const briefPath = option('--brief');
const reviewPackagePath = option('--review-package');
const implementerReportPath = option('--implementer-report');
if (!artifactPath || !taskAnchor || !reviewerThreadId || !model || !Number.isInteger(attempt)
    || !briefPath || !reviewPackagePath || !implementerReportPath) {
  console.error('usage: review-artifact-verify --artifact FILE --task TASK --reviewer-thread ID --model MODEL --attempt N --brief FILE --review-package FILE --implementer-report FILE');
  process.exit(2);
}

const artifact = JSON.parse(await readFile(resolve(artifactPath), 'utf8'));
if (artifact.schema !== 'loopx.review-artifact.v1') {
  throw new Error('review_artifact_schema_unsupported');
}
validateReviewResult(artifact.review_result);
const provenance = artifact.provenance ?? {};
for (const [field, expected] of [
  ['task_anchor', taskAnchor],
  ['reviewer_thread_id', reviewerThreadId],
  ['model', model],
  ['review_attempt', attempt],
]) {
  if (provenance[field] !== expected) {
    throw new Error(`review_artifact_${field}_mismatch`);
  }
}
const inputs = await Promise.all([briefPath, reviewPackagePath, implementerReportPath].map((path) => readFile(resolve(path))));
for (const [field, actual] of [
  ['brief_sha256', sha256(inputs[0])],
  ['review_package_sha256', sha256(inputs[1])],
  ['implementer_report_sha256', sha256(inputs[2])],
]) {
  if (provenance[field] !== actual) {
    throw new Error(`review_artifact_${field}_mismatch`);
  }
}
console.log(resolve(artifactPath));

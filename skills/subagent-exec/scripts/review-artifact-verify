#!/usr/bin/env node

import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';

import { verifyTaskReviewArtifact } from '../../exec/scripts/review-gate.mjs';

function option(name) {
  const index = process.argv.indexOf(name);
  return index === -1 ? null : process.argv[index + 1];
}

const required = [
  '--artifact',
  '--task',
  '--reviewer-id',
  '--model',
  '--platform',
  '--attempt',
  '--brief',
  '--report',
  '--diff-package',
  '--verification',
];
if (required.some((name) => !option(name))) {
  console.error('usage: review-artifact-verify --artifact FILE --task ID --reviewer-id ID --model MODEL --platform NAME --attempt N --brief FILE --report FILE --diff-package FILE --verification FILE');
  process.exit(2);
}

const artifactPath = resolve(option('--artifact'));
const [artifactText, brief, report, diffPackage, verification] = await Promise.all([
  readFile(artifactPath, 'utf8'),
  readFile(resolve(option('--brief'))),
  readFile(resolve(option('--report'))),
  readFile(resolve(option('--diff-package'))),
  readFile(resolve(option('--verification'))),
]);
let artifact;
try {
  artifact = JSON.parse(artifactText);
} catch {
  const error = new Error('review_artifact_json_invalid');
  error.code = 'review_artifact_json_invalid';
  throw error;
}
verifyTaskReviewArtifact({
  artifact,
  taskId: option('--task'),
  reviewer: {
    id: option('--reviewer-id'),
    model: option('--model'),
    platform: option('--platform'),
  },
  attempt: Number(option('--attempt')),
  inputs: { brief, report, diffPackage, verification },
});
console.log(artifactPath);

#!/usr/bin/env node

import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';

import { captureTaskReviewArtifact } from '../../exec/scripts/review-gate.mjs';

function option(name) {
  const index = process.argv.indexOf(name);
  return index === -1 ? null : process.argv[index + 1];
}

const required = [
  '--cwd',
  '--run-id',
  '--task',
  '--reviewer-id',
  '--model',
  '--platform',
  '--attempt',
  '--brief',
  '--report',
  '--diff-package',
  '--verification',
  '--input',
];
if (required.some((name) => !option(name))) {
  console.error('usage: review-result --cwd DIR --run-id ID --task ID --reviewer-id ID --model MODEL --platform NAME --attempt N --brief FILE --report FILE --diff-package FILE --verification FILE --input FILE');
  process.exit(2);
}

const paths = {
  brief: resolve(option('--brief')),
  report: resolve(option('--report')),
  diffPackage: resolve(option('--diff-package')),
  verification: resolve(option('--verification')),
};
const [brief, report, diffPackage, verification, rawMessage] = await Promise.all([
  readFile(paths.brief),
  readFile(paths.report),
  readFile(paths.diffPackage),
  readFile(paths.verification),
  readFile(resolve(option('--input')), 'utf8'),
]);
const { path } = await captureTaskReviewArtifact({
  cwd: resolve(option('--cwd')),
  runId: option('--run-id'),
  taskId: option('--task'),
  reviewer: {
    id: option('--reviewer-id'),
    model: option('--model'),
    platform: option('--platform'),
  },
  attempt: Number(option('--attempt')),
  inputs: { brief, report, diffPackage, verification },
  rawMessage,
});
console.log(path);

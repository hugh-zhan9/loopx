    { "skill": "review", "role": "workflow", "boundary": "Not for routine verification", "required_outputs": ["Review Result"], "safety_invariants": ["Critical and Important"], "integrations": ["shared/review-contract.md"], "required_references": ["../shared/review-contract.md"], "version": "0.4.0" },
    { "skill": "final-review", "role": "workflow", "boundary": "explicit-only compatibility alias", "required_outputs": ["Forwarding Contract"], "safety_invariants": ["does not require"], "integrations": ["review"], "required_references": [], "version": "0.4.0" },
    { "skill": "fix-review", "role": "workflow", "boundary": "explicit-only compatibility alias", "required_outputs": ["Forwarding Contract"], "safety_invariants": ["does not require"], "integrations": ["review"], "required_references": [], "version": "0.4.0" },

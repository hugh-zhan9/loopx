    { "skill": "codebase-spec", "role": "workflow", "boundary": "Do not:", "required_outputs": ["Evidence Standard"], "safety_invariants": ["Never print secret values"], "integrations": ["spec"], "required_references": ["references/output-template.md"], "version": "0.1.2" },
    { "skill": "plan", "role": "workflow", "boundary": "Do not settle those decisions", "required_outputs": ["Outcomes", "Acceptance", "Verification"], "safety_invariants": ["STOP Conditions"], "integrations": ["exec"], "required_references": ["references/plan-schema.md"], "version": "0.1.0" },

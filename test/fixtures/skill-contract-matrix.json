      "safety_invariants": [
        "never generated `.pb.go`"
      ],
      "integrations": [
        "go-style"
      ],
      "required_references": [],
      "version": "0.3.8"
    },
    {
      "skill": "api-designer",
      "role": "support",
      "boundary": "support lens",
      "required_outputs": [

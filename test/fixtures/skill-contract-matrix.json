{
  "schema_version": 1,
  "workflow_root_line_limits": {
    "task-split": {
      "max": 80
    },
    "clarify": {
      "max": 90
    },
    "spec": {
      "max": 110
    },
    "codebase-spec": {
      "max": 80
    },
    "plan2exec": {
      "max": 95
    },
    "exec": {
      "max": 95
    },
    "refactor-plan": {
      "max": 80
    },
    "release-readiness": {
      "max": 90
    }
  },
  "skills": [
    {
      "skill": "task-split",
      "role": "workflow",
      "boundary": "Do not write implementation plans",
      "required_outputs": [
        "deliverable",
        "dependencies",
        "acceptance"
      ],
      "safety_invariants": [
        "no CLI runtime"
      ],
      "integrations": [
        "clarify",
        "spec",
        "plan2exec"
      ],
      "required_references": [
        "references/task-documents.md",
        "agents/openai.yaml"
      ],
      "version": "0.2.0"
    },
    {
      "skill": "clarify",
      "role": "workflow",
      "boundary": "Do not write an implementation plan",
      "required_outputs": [
        "requirements.md",
        "AC-*",
        "TC-*"
      ],
      "safety_invariants": [
        "PENDING"
      ],
      "integrations": [
        "frontier"
      ],
      "required_references": [
        "../shared/domain-language.md",
        "references/owner-questions.md",
        "references/ambiguity-table.md",
        "agents/openai.yaml"
      ],
      "version": "0.7.0"
    },
    {
      "skill": "spec",
      "role": "workflow",
      "boundary": "Do not write",
      "required_outputs": [
        "Design Contract",
        "Verification Strategy"
      ],
      "safety_invariants": [
        "unresolved"
      ],
      "integrations": [
        "plan2exec"
      ],
      "required_references": [
        "../shared/database-concurrency.md",
        "../shared/domain-language.md",
        "DESIGN_SPEC_TEMPLATE.md",
        "REVIEW_BRIEF_TEMPLATE.md",
        "references/caller-driven-api.md",
        "references/design-review.md",
        "references/design-quality.md",
        "references/design-diagrams.md",
        "agents/openai.yaml"
      ],
      "version": "0.7.0"
    },
    {
      "skill": "codebase-spec",
      "role": "workflow",
      "boundary": "Do not edit code",
      "required_outputs": [
        "Observed",
        "Inferred",
        "Unknown"
      ],
      "safety_invariants": [
        "Never print secrets"
      ],
      "integrations": [
        "spec"
      ],
      "required_references": [
        "references/output-template.md",
        "references/evidence-checklist.md",
        "agents/openai.yaml"
      ],
      "version": "0.2.0"
    },
    {
      "skill": "plan2exec",
      "role": "workflow",
      "boundary": "document contract",
      "required_outputs": [
        "loopx-plan/v1",
        "validate-plan.mjs"
      ],
      "safety_invariants": [
        "blocked"
      ],
      "integrations": [
        "clarify",
        "spec"
      ],
      "required_references": [
        "references/plan-schema.md",
        "references/plan-review.md",
        "scripts/validate-plan.mjs",
        "../shared/database-concurrency.md",
        "agents/openai.yaml"
      ],
      "version": "0.9.1"
    },
    {
      "skill": "exec",
      "role": "workflow",
      "boundary": "does not author feature code or tests",
      "required_outputs": [
        "loopx-plan/v1",
        "frontier"
      ],
      "safety_invariants": [
        "leaf worker"
      ],
      "integrations": [
        "code-review"
      ],
      "required_references": [
        "references/recovery.md",
        "references/review-coverage.md",
        "../plan2exec/scripts/validate-plan.mjs",
        "../code-review/scripts/check-guardrails.mjs",
        "agents/openai.yaml"
      ],
      "version": "1.3.0"
    },
    {
      "skill": "refactor-plan",
      "role": "workflow",
      "boundary": "Behavior changes belong in",
      "required_outputs": [
        "REFACTOR_PLAN_TEMPLATE.md",
        "deletion test"
      ],
      "safety_invariants": [
        "behavior baseline"
      ],
      "integrations": [
        "plan2exec"
      ],
      "required_references": [
        "REFACTOR_PLAN_TEMPLATE.md",
        "references/code-audit.md",
        "references/fowler-refactorings.md",
        "scripts/audit_codebase.py",
        "agents/openai.yaml"
      ],
      "version": "0.7.0"
    },
    {
      "skill": "release-readiness",
      "role": "workflow",
      "boundary": "runbook is not",
      "required_outputs": [
        "prerequisites",
        "rollback"
      ],
      "safety_invariants": [
        "unknown"
      ],
      "integrations": [
        "runbook-template.md"
      ],
      "required_references": [
        "references/runbook-template.md",
        "agents/openai.yaml"
      ],
      "version": "0.2.0"
    },
    {
      "skill": "debug",
      "role": "support",
      "boundary": "leave every repository",
      "required_outputs": [
        "feedback loop",
        "hypotheses"
      ],
      "safety_invariants": [
        "REDACTED"
      ],
      "integrations": [
        "code-review"
      ],
      "required_references": [
        "references/existing-ledgers.md",
        "references/diagnosis-contract.md",
        "root-cause-tracing.md",
        "condition-based-waiting.md",
        "defense-in-depth.md",
        "agents/openai.yaml"
      ],
      "version": "0.6.0"
    },
    {
      "skill": "tdd",
      "role": "support",
      "boundary": "Never delete existing code",
      "required_outputs": [
        "vertical slices",
        "seam"
      ],
      "safety_invariants": [
        "RED"
      ],
      "integrations": [
        "code-review"
      ],
      "required_references": [
        "testing-anti-patterns.md",
        "references/mutation-check.md",
        "agents/openai.yaml"
      ],
      "version": "0.4.0"
    },
    {
      "skill": "code-review",
      "role": "support",
      "boundary": "never let reviewers edit files",
      "required_outputs": [
        "Standards",
        "Spec"
      ],
      "safety_invariants": [
        "check-guardrails.mjs"
      ],
      "integrations": [
        "parallel read-only"
      ],
      "required_references": [
        "scripts/check-guardrails.mjs",
        "agents/openai.yaml"
      ],
      "version": "0.2.0"
    },
    {
      "skill": "go-kratos",
      "role": "support",
      "boundary": "Never edit generated files",
      "required_outputs": [
        "numeric precision",
        "subpackages"
      ],
      "safety_invariants": [
        "float32"
      ],
      "integrations": [
        "database-concurrency.md"
      ],
      "required_references": [
        "../shared/database-concurrency.md",
        "../code-review/scripts/check-guardrails.mjs",
        "references/concurrency.md",
        "references/performance.md",
        "references/modernization.md",
        "references/kratos-ops.md",
        "agents/openai.yaml"
      ],
      "version": "0.1.0"
    },
    {
      "skill": "generate-api-docs",
      "role": "support",
      "boundary": "Do not",
      "required_outputs": [
        "actual HTTP endpoint",
        "output-contract.md"
      ],
      "safety_invariants": [
        "阻断"
      ],
      "integrations": [
        "openapi-output-contract.md"
      ],
      "required_references": [
        "references/source-discovery.md",
        "references/output-contract.md",
        "references/openapi-output-contract.md",
        "agents/openai.yaml"
      ],
      "version": "0.2.0"
    },
    {
      "skill": "humanize-doc",
      "role": "support",
      "boundary": "invent nothing",
      "required_outputs": [
        "readability.md",
        "Preserve meaning"
      ],
      "safety_invariants": [
        "decision status"
      ],
      "integrations": [
        "examples.md"
      ],
      "required_references": [
        "references/readability.md",
        "references/examples.md",
        "references/prd.md",
        "agents/openai.yaml"
      ],
      "version": "0.4.0"
    },
    {
      "skill": "ask-loopx",
      "role": "support",
      "boundary": "Do not execute",
      "required_outputs": [
        "Model-invoked",
        "User-invoked"
      ],
      "safety_invariants": [
        "zero always-on context cost"
      ],
      "integrations": [
        "debug",
        "spec",
        "plan2exec"
      ],
      "required_references": [
        "agents/openai.yaml"
      ],
      "version": "0.1.0"
    }
  ]
}

{
  "schema_version": 1,
  "workflow_root_line_limits": {
    "clarify": {
      "max": 160
    },
    "spec": {
      "max": 200
    },
    "codebase-spec": {
      "max": 160
    },
    "plan2exec": {
      "max": 140,
      "reason": "Keeps traceable execution slices and handoff requirements directly actionable without implementation microsteps."
    },
    "exec": {
      "max": 135
    },
    "refactor-plan": {
      "max": 100
    }
  },
  "skills": [
    {
      "skill": "clarify",
      "role": "workflow",
      "boundary": "Do not choose or invoke a next skill",
      "required_outputs": [
        "goals",
        "decisions",
        "boundaries",
        "evidence"
      ],
      "safety_invariants": [
        "pending"
      ],
      "integrations": [
        "documents"
      ],
      "required_references": [],
      "version": "0.5.0"
    },
    {
      "skill": "spec",
      "role": "workflow",
      "boundary": "Do not write an implementation plan",
      "required_outputs": [
        "architecture conformance contract",
        "Design Contract Index"
      ],
      "safety_invariants": [
        "unresolved decisions"
      ],
      "integrations": [
        "plan2exec"
      ],
      "required_references": [
        "../shared/architecture-conformance.md",
        "../shared/database-concurrency.md",
        "DESIGN_SPEC_TEMPLATE.md",
        "REVIEW_BRIEF_TEMPLATE.md",
        "references/design-review.md",
        "references/design-quality.md",
        "references/design-diagrams.md"
      ],
      "version": "0.5.0"
    },
    {
      "skill": "codebase-spec",
      "role": "workflow",
      "boundary": "Do not change",
      "required_outputs": [
        "Scope and evidence"
      ],
      "safety_invariants": [
        "Never print secrets"
      ],
      "integrations": [
        "spec"
      ],
      "required_references": [
        "references/output-template.md"
      ],
      "version": "0.1.5"
    },
    {
      "skill": "plan2exec",
      "role": "workflow",
      "boundary": "Do not add task microsteps",
      "required_outputs": [
        "execution slice",
        "Each slice's `architecture` line",
        "Goal And Boundaries",
        "Integration And Final Verification",
        "Handoff And Residual Risks"
      ],
      "safety_invariants": [
        "Block only affected work"
      ],
      "integrations": [
        "exec"
      ],
      "required_references": [
        "references/plan-schema.md",
        "../shared/architecture-conformance.md",
        "../shared/database-concurrency.md",
        "references/plan-review.md"
      ],
      "version": "0.7.0"
    },
    {
      "skill": "exec",
      "role": "workflow",
      "boundary": "does not author feature code",
      "required_outputs": [
        "Report the effective subagent profile",
        "architecture-conformance evidence",
        "verification evidence",
        "base identity and either an isolated-workspace"
      ],
      "safety_invariants": [
        "Never let concurrent workers edit the controller",
        "Do not spawn or wait for other agents",
        "Review and integrate parallel results one at a time"
      ],
      "integrations": [
        "plan2exec",
        "clarify",
        "spec"
      ],
      "required_references": [
        "../shared/architecture-conformance.md",
        "references/recovery.md",
        "../plan2exec/references/plan-review.md"
      ],
      "version": "1.1.0"
    },
    {
      "skill": "refactor-plan",
      "role": "workflow",
      "boundary": "behavior-preserving",
      "required_outputs": [
        "Behavior Preservation Contract"
      ],
      "safety_invariants": [
        "A draft is not approved"
      ],
      "integrations": [
        "clarify",
        "spec",
        "plan2exec"
      ],
      "required_references": [
        "REFACTOR_PLAN_TEMPLATE.md",
        "references/code-audit.md",
        "references/smell-patterns.md",
        "references/governance-rules.md",
        "scripts/audit_codebase.py"
      ],
      "version": "0.6.0"
    },
    {
      "skill": "debug",
      "role": "support",
      "boundary": "diagnosis-only",
      "required_outputs": [
        "root_cause_status"
      ],
      "safety_invariants": [
        "hypotheses_rejected"
      ],
      "integrations": [
        "lancet",
        "completion-check.md"
      ],
      "required_references": [
        "references/diagnosis-contract.md",
        "references/four-phases.md",
        "references/existing-ledgers.md",
        "../shared/completion-check.md"
      ],
      "version": "0.4.0"
    },
    {
      "skill": "tdd",
      "role": "support",
      "boundary": "failing test",
      "required_outputs": [
        "RED"
      ],
      "safety_invariants": [
        "Preserve"
      ],
      "integrations": [
        "owning implementation workflow"
      ],
      "required_references": [
        "references/red-green-refactor.md",
        "testing-anti-patterns.md"

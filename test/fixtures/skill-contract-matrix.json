        "worktree"
      ],
      "safety_invariants": [
        "postinstall hooks"
      ],
      "integrations": [
        "exec"
      ],
      "required_references": [],
      "version": "0.1.7"
    },
    {
      "skill": "humanize-doc",
      "role": "support",
      "boundary": "not product decisions or workflow state",
      "required_outputs": [
        "Readability verdict",
        "deletion ledger"
      ],
      "safety_invariants": [
        "Invent nothing",
        "Assessment only"
      ],
      "integrations": [
        "requirement-analyzer"
      ],
      "required_references": [
        "references/examples.md",
        "references/readability.md",
        "references/prd.md"
      ],
      "version": "0.3.1"
    },
    {
      "skill": "maintain-project-docs",
      "role": "support",
      "boundary": "does not decide new product",
      "required_outputs": [
        "authority map",
        "archive manifest"
      ],
      "safety_invariants": [
        "Archive before delete"
      ],
      "integrations": [
        "humanize-doc"
      ],
      "required_references": [],
      "version": "0.1.3"
    },
    {
      "skill": "requirement-analyzer",
      "role": "support",
      "boundary": "does NOT",
      "required_outputs": [
        "qualitative"
      ],
      "safety_invariants": [
        "unresolved decision"
      ],
      "integrations": [

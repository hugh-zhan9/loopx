{
  "schema_version": 1,
  "workflow_root_line_limits": {
    "clarify": {
      "max": 160
    },
    "spec": {
      "max": 245,
      "reason": "Keeps the proposal and detailed-design handoff contract directly executable."
    },
    "codebase-spec": {
      "max": 160
    },
    "plan2exec": {
      "max": 140,
      "reason": "Keeps traceable execution slices and handoff requirements directly actionable without implementation microsteps."
    },
    "exec": {
      "max": 135
    },
    "issue": {
      "max": 290,
      "reason": "Owns issue intake, diagnosis handoff, ledger state, and fix-readiness gates."
    },
    "fix": {
      "max": 260,
      "reason": "Owns issue-ledger admission, execution evidence, review closure, and recovery handoff."
    },
    "refactor-plan": {
      "max": 100
    },
    "design-review": {
      "max": 220
    }
  },
  "skills": [
    {
      "skill": "clarify",
      "role": "workflow",
      "boundary": "Do not choose or invoke a next skill",
      "required_outputs": [
        "goals",

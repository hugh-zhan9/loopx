{
  "schema_version": 1,
  "workflow_root_line_limits": {
    "clarify": { "max": 160 },
    "spec": { "max": 230, "reason": "Keeps the proposal and detailed-design handoff contract directly executable." },
    "codebase-spec": { "max": 160 },
    "plan2exec": { "max": 140, "reason": "Keeps traceable execution slices and handoff requirements directly actionable without implementation microsteps." },
    "issue": { "max": 290, "reason": "Owns issue intake, diagnosis handoff, ledger state, and fix-readiness gates." },
    "fix": { "max": 260, "reason": "Owns issue-ledger execution, verification, review closure, and finish handoff." },
    "refactor-plan": { "max": 100 }
  },
  "skills": [
    {"skill": "clarify", "role": "workflow", "boundary": "Do not write implementation plans", "required_outputs": ["handoff_decision"], "safety_invariants": ["blocked"], "integrations": ["plan2exec"], "required_references": ["references/handoff-syntax.md"], "version": "0.3.18"},
    {"skill": "spec", "role": "workflow", "boundary": "Do not write an implementation plan", "required_outputs": ["Accepted proposal"], "safety_invariants": ["STOP Conditions"], "integrations": ["plan2exec"], "required_references": [], "version": "0.4.1"},
    {"skill": "codebase-spec", "role": "workflow", "boundary": "Do not:", "required_outputs": ["Evidence Standard"], "safety_invariants": ["Never print secret values"], "integrations": ["spec"], "required_references": ["references/output-template.md"], "version": "0.1.2"},
    {"skill": "plan2exec", "role": "workflow", "boundary": "Do not add task microsteps", "required_outputs": ["Execution Slices", "Integration And Final Verification", "Handoff And Residual Risks"], "safety_invariants": ["STOP Conditions"], "integrations": ["exec"], "required_references": ["references/plan-schema.md"], "version": "0.5.0"},
    {"skill": "plan-reviewer", "role": "support", "boundary": "does not edit the plan", "required_outputs": ["assessment"], "safety_invariants": ["Do not infer"], "integrations": ["plan2exec"], "required_references": [], "version": "0.5.0"},
    {"skill": "issue", "role": "workflow", "boundary": "bug-class", "required_outputs": ["fix brief", "Short-Form Ledger"], "safety_invariants": ["ready_for_fix"], "integrations": ["debug"], "required_references": [], "version": "0.4.0"},
    {"skill": "fix", "role": "workflow", "boundary": "ready_for_fix", "required_outputs": ["verification evidence"], "safety_invariants": ["leaf worker"], "integrations": ["review", "completion-check.md"], "required_references": ["../shared/completion-check.md"], "version": "0.2.1"},
    {"skill": "refactor-plan", "role": "workflow", "boundary": "behavior-preserving", "required_outputs": ["Behavior Preservation Contract"], "safety_invariants": ["plan-reviewer"], "integrations": ["exec"], "required_references": ["REFACTOR_PLAN_TEMPLATE.md"], "version": "0.3.10"},
    {"skill": "debug", "role": "support", "boundary": "diagnosis-only", "required_outputs": ["root_cause_status"], "safety_invariants": ["hypotheses_rejected"], "integrations": ["issue"], "required_references": ["references/diagnosis-contract.md"], "version": "0.3.6"},
    {"skill": "tdd", "role": "support", "boundary": "failing test", "required_outputs": ["RED"], "safety_invariants": ["Preserve"], "integrations": ["owning implementation workflow"], "required_references": [], "version": "0.3.5"},
    {"skill": "verify", "role": "support", "boundary": "fresh verification evidence", "required_outputs": ["Evidence before claims"], "safety_invariants": ["cannot claim it passes"], "integrations": ["shared/evidence-contract.md"], "required_references": ["../shared/evidence-contract.md"], "version": "0.3.5"},
    {"skill": "using-git-worktrees", "role": "support", "boundary": "isolated workspace", "required_outputs": ["worktree"], "safety_invariants": ["postinstall hooks"], "integrations": ["exec"], "required_references": [], "version": "0.1.4"},
    {"skill": "doc-readability", "role": "support", "boundary": "readability", "required_outputs": ["Readability verdict"], "safety_invariants": ["semantic preservation"], "integrations": ["requirements document"], "required_references": [], "version": "0.3.5"},
    {"skill": "requirement-analyzer", "role": "support", "boundary": "does NOT", "required_outputs": ["qualitative"], "safety_invariants": ["unresolved decision"], "integrations": ["clarify"], "required_references": [], "version": "0.3.6"},
    {"skill": "go-style", "role": "support", "boundary": "non-Go code", "required_outputs": ["gofmt"], "safety_invariants": ["Do not edit generated Go files"], "integrations": ["kratos"], "required_references": [], "version": "0.3.8"},
    {"skill": "kratos", "role": "support", "boundary": "generic Go style", "required_outputs": ["Verification"], "safety_invariants": ["Do not edit generated"], "integrations": ["go-style"], "required_references": [], "version": "0.3.5"},
    {"skill": "api-designer", "role": "support", "boundary": "support lens", "required_outputs": ["OpenAPI 3.1"], "safety_invariants": ["do not use `npx`"], "integrations": ["spec"], "required_references": ["references/versioning.md"], "version": "0.3.7"},
    {"skill": "architecture-designer", "role": "support", "boundary": "support lens", "required_outputs": ["failure-mode table"], "safety_invariants": ["STOP Conditions"], "integrations": ["spec"], "required_references": ["references/nfr-checklist.md"], "version": "0.3.7"},
    {"skill": "sql-style", "role": "support", "boundary": "support lens", "required_outputs": ["EXPLAIN"], "safety_invariants": ["expand/contract"], "integrations": ["spec"], "required_references": [], "version": "0.3.6"},
    {"skill": "cli-developer", "role": "support", "boundary": "support lens", "required_outputs": ["Output contract"], "safety_invariants": ["non-interactive"], "integrations": ["spec"], "required_references": ["references/design-patterns.md"], "version": "0.3.8"},
    {"skill": "lancet", "role": "support", "boundary": "support lens, not a workflow state", "required_outputs": ["smallest correct diff"], "safety_invariants": ["AC-*"], "integrations": ["exec"], "required_references": [], "version": "0.1.3"}
  ]
}

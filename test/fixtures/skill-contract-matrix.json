      ],
      "safety_invariants": [
        "Do not change implementation, invent future behavior",
        "Generate `<name>.openapi.yaml` only when the user explicitly requests",
        "Do not generate temporary YAML just to validate Markdown",
        "Simplify and humanize before delivery",
        "Document each scenario independently",
        "Test each scenario before writing examples",
        "If any requested scenario cannot be tested, stop the skill immediately"
      ],
      "integrations": [
        "api-designer",
        "codebase-spec",
        "lancet",
        "humanize-doc"
      ],
      "required_references": [

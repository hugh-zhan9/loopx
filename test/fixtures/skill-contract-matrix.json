    { "skill": "plan-reviewer", "role": "support", "boundary": "must not create a workflow state", "required_outputs": ["Coverage Matrix"], "safety_invariants": ["Critical and Important findings block"], "integrations": ["plan-to-exec"], "required_references": [], "version": "0.1.5" },

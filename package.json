{
  "name": "@ai-content-space/loopx",
  "type": "module",
  "version": "0.5.1",
  "description": "Skill-first workflow suite for agentic coding assistants",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugh-zhan9/loopx.git"
  },
  "keywords": [
    "codex",
    "loopx",
    "skills",
    "workflow",
    "plugin"
  ],
  "bin": {
    "loopx": "src/cli.mjs"
  },
  "files": [
    "AGENTS.md",
    "README.md",
    "README.zh-CN.md",
    "docs/loopx/cli.md",
    "docs/loopx/cli.zh-CN.md",
    "docs/loopx/skills.md",
    "docs/loopx/skills.zh-CN.md",
    "docs/loopx/specs/installation.md",
    "package.json",
    "scripts/install-skills.mjs",
    "scripts/verify-skills.mjs",
    "scripts/run-agent-evals.mjs",
    "scripts/normalize-codex-agent-trace.mjs",
    "scripts/run-codex-live-agent-evals.mjs",
    "scripts/aggregate-agent-evals.mjs",
    "scripts/claude-workflow-hook.mjs",
    "scripts/codex-workflow-hook.mjs",
    "assets/logo.svg",
    "evals/gpt-5.6/",
    "src/",
    "skills/RESOLVER.md",
    "skills/shared/",
    "test/fixtures/skill-contract-matrix.json",
    "skills/api-designer/",
    "skills/architecture-designer/",
    "skills/clarify/",
    "skills/cli-developer/",
    "skills/codebase-spec/",
    "skills/debug/",
    "skills/doc-readability/",
    "skills/exec/",
    "skills/final-review/",
    "skills/finish/",
    "skills/fix-review/",
    "skills/go-style/",
    "skills/issue/",
    "skills/fix/",
    "skills/kratos/",
    "skills/lancet/",
    "skills/plan-to-exec/",
    "skills/plan-reviewer/",
    "skills/parallel-subagent-exec/",
    "skills/refactor-plan/",
    "skills/requirement-analyzer/",
    "skills/review/",
    "skills/sql-style/",
    "skills/spec/",
    "skills/subagent-exec/",
    "skills/tdd/",
    "skills/using-git-worktrees/",
    "skills/verify/",
    "templates/spec.md",
    "templates/intake-clarification.md",
    "templates/intake-requirements.md",
    "plugins/loopx/",
    "!plugins/loopx/scripts/plugin-install.test.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "postinstall": "node scripts/install-skills.mjs",
    "eval:agent": "node scripts/run-agent-evals.mjs",
    "eval:codex-normalize": "node scripts/normalize-codex-agent-trace.mjs",
    "eval:codex-live": "node scripts/run-codex-live-agent-evals.mjs",
    "eval:aggregate": "node scripts/aggregate-agent-evals.mjs",
    "test": "node scripts/verify-skills.mjs && node --test test/*.test.mjs"
  }
}

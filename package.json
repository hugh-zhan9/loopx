{
  "name": "@ai-content-space/loopx",
  "type": "module",
  "version": "0.2.3",
  "description": "Skill-first workflow suite for agentic coding assistants",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugh-zhan9/loopx.git"
  },
  "keywords": [
    "codex",
    "loopx",
    "skills",
    "workflow",
    "plugin"
  ],
  "bin": {
    "loopx": "src/cli.mjs"
  },
  "files": [
    "AGENTS.md",
    "README.md",
    "README.zh-CN.md",
    "docs/loopx/",
    "package.json",
    "scripts/install-skills.mjs",
    "scripts/verify-skills.mjs",
    "scripts/claude-workflow-hook.mjs",
    "scripts/codex-stop-hook.mjs",
    "scripts/codex-workflow-hook.mjs",
    "assets/logo.svg",
    "src/",
    "skills/",
    "templates/",
    "plugins/loopx/",
    "!plugins/loopx/scripts/plugin-install.test.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "postinstall": "node scripts/install-skills.mjs",
    "test": "node scripts/verify-skills.mjs && node --test test/*.test.mjs"
  }
}

{
  "name": "@ai-content-space/loopx",
  "type": "module",
  "version": "0.8.3",
  "description": "Docs-first engineering discipline for agentic coding assistants",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugh-zhan9/loopx.git"
  },
  "keywords": [
    "codex",
    "loopx",
    "skills",
    "workflow",
    "plugin"
  ],
  "bin": {
    "loopx": "src/cli.mjs"
  },
  "files": [
    "AGENTS.md",
    "README.md",
    "README.zh-CN.md",
    "docs/loopx/cli.md",
    "docs/loopx/cli.zh-CN.md",
    "docs/loopx/skills.md",
    "docs/loopx/skills.zh-CN.md",
    "docs/loopx/specs/installation.md",
    "package.json",
    "scripts/install-skills.mjs",
    "assets/logo.svg",
    "src/cli.mjs",
    "src/html-views.mjs",
    "src/install-discovery.mjs",
    "src/loopx-context-artifacts.mjs",
    "src/project-discovery.mjs",
    "src/runtime-maintenance.mjs",
    "src/template-governance.mjs",
    "src/version-check.mjs",
    "src/workflow.mjs",
    "src/workspace-context.mjs",
    "skills/RESOLVER.md",
    "skills/shared/",
    "skills/api-designer/",
    "skills/architecture-designer/",
    "skills/clarify/",
    "skills/cli-developer/",
    "skills/codebase-spec/",
    "skills/debug/",
    "skills/doc-readability/",
    "skills/go-style/",
    "skills/humanize-doc/",
    "skills/maintain-project-docs/",
    "skills/issue/",
    "skills/fix/",
    "skills/kratos/",
    "skills/lancet/",
    "skills/plan2exec/",
    "skills/plan-reviewer/",
    "skills/refactor-plan/",
    "skills/requirement-analyzer/",
    "skills/sql-style/",
    "skills/spec/",
    "skills/tdd/",
    "skills/using-git-worktrees/",
    "skills/verify/",
    "templates/spec.md",
    "templates/working-agreement.md",
    "templates/intake-clarification.md",
    "templates/intake-requirements.md",
    "plugins/loopx/",
    "!plugins/loopx/scripts/plugin-install.test.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "postinstall": "node scripts/install-skills.mjs",
    "eval:agent": "node scripts/run-agent-evals.mjs",
    "eval:codex-normalize": "node scripts/normalize-codex-agent-trace.mjs",
    "eval:codex-live": "node scripts/run-codex-live-agent-evals.mjs",
    "eval:claude-live": "node scripts/run-claude-live-agent-evals.mjs",
    "eval:darwin-simple": "node scripts/run-darwin-simple-evals.mjs",
    "eval:req-demo": "node scripts/run-req-demo-evals.mjs",
    "eval:benchmark": "node scripts/run-benchmark-evals.mjs",
    "eval:benchmark:aggregate": "node scripts/aggregate-benchmark-reports.mjs",
    "eval:drills": "node scripts/run-drills.mjs",
    "eval:aggregate": "node scripts/aggregate-agent-evals.mjs",
    "test": "node scripts/verify-skills.mjs && node --test test/*.test.mjs"
  }
}
